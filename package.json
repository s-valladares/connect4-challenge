{
  "name": "connect4-challenge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Challenge Cuatro en Línea 8×7 — bot de torneo + web humano vs bot (Equipo 5)",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "bot": "node src/worker/main.js",
    "api": "node src/infrastructure/http/server.js",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "train": "node src/training/self-play.js",
    "benchmark": "node src/training/benchmark.js",
    "practice": "node scripts/practice.js",
    "submit": "node scripts/register-submission.js",
    "health": "node scripts/health-check.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
